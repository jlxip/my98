#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

# The tests read the working tree, so tracked files must match the index.
if ! git diff --quiet --ignore-submodules=none; then
    printf '%s\n' 'Commit blocked: stage or stash unstaged changes before running the tests.' >&2
    exit 1
fi

# The clean runner snapshots this exact index before clearing Git's hook environment.
printf '%s\n' 'Running the GitHub Pages test suite from a clean staged snapshot...'
exec python3 scripts/clean-site-test.py
